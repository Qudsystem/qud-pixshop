{
  "name": "ai-studio-automation",
  "version": "1.0.0",
  "description": "AI Studio Automation Layer - REST API for automated image processing",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:integration": "jest tests/integration",
    "test:unit": "jest tests/unit",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "docker:build": "docker build -t ai-studio-automation .",
    "docker:run": "docker run -p 3000:3000 --env-file .env ai-studio-automation",
    "docker:compose": "docker-compose up -d",
    "cluster": "set CLUSTER_MODE=true&& node src/server.js",
    "monitor": "node src/utils/monitor-dashboard.js"
  },
  "keywords": [
    "ai",
    "automation",
    "image-processing",
    "api",
    "playwright",
    "redis",
    "queue",
    "load-balancer",
    "monitoring",
    "alerts"
  ],
  "author": "AI Studio Automation Team",
  "license": "MIT",
  "dependencies": {
    "bull": "^4.12.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "joi": "^17.12.2",
    "jsonwebtoken": "^9.0.2",
    "playwright": "^1.42.1",
    "redis": "^4.6.13",
    "winston": "^3.12.0",
    "nodemailer": "^6.9.12",
    "cluster": "^0.7.7",
    "os": "^0.1.2"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/ai-studio-automation.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/ai-studio-automation/issues"
  },
  "homepage": "https://github.com/your-org/ai-studio-automation#readme"
}